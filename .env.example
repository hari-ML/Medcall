# MedRecall environment configuration — copy to ".env" and fill in real values.
# NEVER commit ".env" or real secrets (git-ignored; enforce in review).
#
# Note: the backend reads these from the process environment. On Windows
# PowerShell for one session:  $env:POPPLER_PATH="..."   (then start uvicorn)
# or use a .env loader when the backend grows one (Phase 1 introduces
# pydantic-settings so ".env" is read automatically).

# --- Database --------------------------------------------------------------
# SQLite path or full SQLAlchemy URL. Leave unset to use the default
# (backend/medrecall.db). If set as a relative path it is resolved from the
# process working directory, so prefer an absolute path when unsure.
# MEDRECALL_DB=C:/Users/<you>/medrecall/backend/medrecall.db

# --- PDF rendering (pdf2image) --------------------------------------------
# Directory containing pdftoppm. Auto-detected for winget installs; set this
# only if Poppler lives somewhere unusual. Example:
# POPPLER_PATH=C:\Users\<you>\AppData\Local\Microsoft\WinGet\Packages\oschwartz10612.Poppler_Microsoft.Winget.Source_8wekyb3d8bbwe\poppler-25.07.0\Library\bin

# --- Audit scripts ---------------------------------------------------------
# Base URL used by scripts/safety_audit.mjs and scripts/api_contract.mjs.
# Default: http://127.0.0.1:8000. NOTE: port 8000 is occupied on this
# machine by an unrelated app, so run uvicorn on 8001 and set:
MEDRECALL_API=http://127.0.0.1:8001

# --- Foundation (Phase 1) ---------------------------------------------------
# development | production  (production will enforce a real SECRET_KEY once auth lands)
MEDRECALL_ENV=development
# Logging: DEBUG | INFO | WARNING | ERROR
MEDRECALL_LOG_LEVEL=INFO
# Comma-separated browser origins allowed by CORS (Vite dev server)
MEDRECALL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Secrets (Phase 2+: sessions/JWT) --------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# Leave empty in development; a random dev-only key is generated if unset.
SECRET_KEY=

# --- Reminder engine (Phase 3) ---------------------------------------------
# Background dispatcher loop (set to off when running a cron-style tick instead).
MEDRECALL_REMINDER_DISPATCHER=on
# Seconds between dispatcher ticks.
MEDRECALL_REMINDER_INTERVAL_SECONDS=30
# How far ahead occurrences are generated.
MEDRECALL_REMINDER_HORIZON_HOURS=48
# A due dose older than this is marked "missed" and never sent late.
MEDRECALL_REMINDER_GRACE_MINUTES=120
# Failed delivery attempts before an occurrence becomes "failed".
MEDRECALL_REMINDER_MAX_ATTEMPTS=3
# Exponential backoff for transient provider failures (429/5xx/timeouts).
MEDRECALL_REMINDER_RETRY_BASE_SECONDS=60
MEDRECALL_REMINDER_RETRY_MAX_SECONDS=3600
# fake = record sends locally (development only; ignored in production).
# Real providers are wired below; until configured, production marks sends failed.
MEDRECALL_CHANNEL_MODE=fake
# Outbound HTTP timeout for provider calls (seconds).
MEDRECALL_HTTP_TIMEOUT_SECONDS=10

# --- WhatsApp Cloud API (Phase 4) ------------------------------------------
# Leave empty to keep WhatsApp unconfigured (production -> "failed", dev -> fake).
# MEDRECALL_WHATSAPP_TOKEN=
# MEDRECALL_WHATSAPP_PHONE_NUMBER_ID=
# MEDRECALL_WHATSAPP_API_VERSION=v21.0
# Business-initiated messages need an approved template with one body parameter
# ({{1}}). Leave the name empty for free-form text (24-hour service window only).
# MEDRECALL_WHATSAPP_TEMPLATE_NAME=medrecall_reminder
# MEDRECALL_WHATSAPP_TEMPLATE_LANG=en

# --- Twilio SMS (Phase 4) ---------------------------------------------------
# MEDRECALL_SMS_ACCOUNT_SID=
# MEDRECALL_SMS_AUTH_TOKEN=
# MEDRECALL_SMS_FROM=+1...

# --- Twilio voice (Phase 4) -------------------------------------------------
# MEDRECALL_VOICE_ACCOUNT_SID=
# MEDRECALL_VOICE_AUTH_TOKEN=
# MEDRECALL_VOICE_FROM=+1...
# Patient language -> TwiML <Say language>. TTS coverage is provider-dependent.
# MEDRECALL_VOICE_LANG_MAP=en:en-US,ta:ta-IN,hi:hi-IN

# --- AI care agent (Phase 5) -----------------------------------------------
# none = deterministic, grounded answers only (default; no external calls).
# openai = any OpenAI-compatible /chat/completions endpoint (OpenAI, Ollama,
# vLLM, a gateway...). The LLM only rephrases unmatched questions from verified
# context; answers with unverified numbers, doses or times are rejected.
MEDRECALL_AGENT_LLM_PROVIDER=none
# MEDRECALL_AGENT_LLM_API_KEY=
# MEDRECALL_AGENT_LLM_MODEL=
# MEDRECALL_AGENT_LLM_BASE_URL=https://api.openai.com/v1
# MEDRECALL_AGENT_LLM_TIMEOUT_SECONDS=15
# MEDRECALL_AGENT_LLM_MAX_TOKENS=300
