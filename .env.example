# MedRecall environment configuration — copy to ".env" and fill in real values.
# NEVER commit ".env" or real secrets (git-ignored; enforce in review).
#
# Note: the backend reads these from the process environment. On Windows
# PowerShell for one session:  $env:POPPLER_PATH="..."   (then start uvicorn)
# or use a .env loader when the backend grows one (Phase 1 introduces
# pydantic-settings so ".env" is read automatically).

# --- Database --------------------------------------------------------------
# SQLite path or full SQLAlchemy URL. Leave unset to use the default
# (backend/medrecall.db). If set as a relative path it is resolved from the
# process working directory, so prefer an absolute path when unsure.
# MEDRECALL_DB=C:/Users/<you>/medrecall/backend/medrecall.db

# --- PDF rendering (pdf2image) --------------------------------------------
# Directory containing pdftoppm. Auto-detected for winget installs; set this
# only if Poppler lives somewhere unusual. Example:
# POPPLER_PATH=C:\Users\<you>\AppData\Local\Microsoft\WinGet\Packages\oschwartz10612.Poppler_Microsoft.Winget.Source_8wekyb3d8bbwe\poppler-25.07.0\Library\bin

# --- Audit scripts ---------------------------------------------------------
# Base URL used by scripts/safety_audit.mjs and scripts/api_contract.mjs.
# Default: http://127.0.0.1:8000. NOTE: port 8000 is occupied on this
# machine by an unrelated app, so run uvicorn on 8001 and set:
MEDRECALL_API=http://127.0.0.1:8001

# --- Secrets (Phase 2+: sessions/JWT) --------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# Leave empty in development; a random dev-only key is generated if unset.
SECRET_KEY=
